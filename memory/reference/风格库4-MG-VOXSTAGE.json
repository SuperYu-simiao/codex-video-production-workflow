  "materials": ["yellowed_newspaper", "archive_beige_paper", "newsprint_fibers", "print_grain", "halftone_dots", "ink_marks", "subtle_stains", "light_folds", "torn_edges", "scissor_cut_edges", "offset_print_error", "subtle_registration_misalignment"],
  "typography": {
    "headline": "extra_large_bold_condensed_sans_uppercase",
    "body": "traditional_newspaper_serif",
    "data": "large_bold_condensed_sans",

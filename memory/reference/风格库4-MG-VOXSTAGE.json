  "components": ["verified_red_statistic", "black_white_data_card", "map_pin", "verified_red_route", "hand_drawn_arrow", "red_circle", "red_underline", "newspaper_clipping", "archive_photo", "timeline", "verified_headline", "verified_financial_data", "file_number", "figure_label"],
  "shot_modules": ["VS-S01_archive-wall-establishing", "VS-S02_cardboard-portrait-lineup", "VS-S03_protected-identity-file", "VS-S04_financial-number-verdict", "VS-S05_map-route-investigation", "VS-S06_headline-evidence-stack", "VS-S07_archive-timeline", "VS-S08_closing-diorama-tableau"],
  "motion": {

  "renderCache": {
    "reuseMotionShell": true,
    "cacheableRenderClasses": ["overlay-cacheable", "transition"],
    "contentBoundClasses": ["content-bound"],
    "partialRenderRecommendedWhen": ["only text changes", "only screenshot changes", "only subtitle changes", "only bridge BGM changes"],
    "finalRenderStillRequired": true,
    "reason": "新素材必须与人物、字幕和音频重新合成；模板消除的是重复设计和重复调参，不是最终编码过程"
  },
  "qa": [
    "JSON 与 TypeScript 注册表的模块 ID 一致",
    "每个主动作后有至少 0.8 秒阅读停留",
    "人物脸部焦点居中，窄栏不机械裁中",
    "录屏先 contain，隐私遮挡不覆盖有效操作",
    "所有公开截图为非登录页并记录来源",
    "没有 API key、token、账户、私人路径或客户数据",
    "桥接 BGM 只出现在明确停顿段",
